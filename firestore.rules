rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Allow test connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // Top-level playlist collection used by HTML structure
    match /playlist/{itemId} {
      allow read, write: if isSignedIn();
    }

    // Top-level logs collection
    match /logs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Match users and their subcollections
    match /users/{userId} {
      allow get, write: if isOwner(userId);

      match /media_items/{itemId} {
        allow read, write: if isOwner(userId);
      }

      match /players/{playerId} {
        allow read, write: if isOwner(userId);
      }

      match /playlists/{playlistId} {
        allow read, write: if isOwner(userId);
      }

      match /logs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
