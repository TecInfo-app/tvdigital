rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Match users and their subcollections
    match /users/{userId} {
      allow get, write: if isOwner(userId);

      match /media_items/{itemId} {
        allow get, write: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId);
      }

      match /players/{playerId} {
        allow get, write: if isOwner(userId) && isValidId(playerId);
        allow list: if isOwner(userId);
      }

      match /playlists/{playlistId} {
        allow get, write: if isOwner(userId) && isValidId(playlistId);
        allow list: if isOwner(userId);
      }

      match /logs/{logId} {
        allow get, write: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
      }
    }
  }
}
